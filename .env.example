# OEE Pulse — environment template (copy to .env)

# Demo mode: when true, email is simulated (no SMTP send)
OEE_PULSE_DEMO_MODE=true

# Optional SMTP for plant brief emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=oee-pulse@yourplant.com
SMTP_TO=plant.manager@yourplant.com

# App
APP_TITLE=OEE Pulse
PLANT_NAME=North Plant

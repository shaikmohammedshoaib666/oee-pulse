# OEE Pulse — environment template (copy to .env)
# On Streamlit Cloud, paste the same keys into App settings → Secrets.

# Demo mode: when true (or SMTP_HOST empty), email is saved to disk instead of sent
OEE_PULSE_DEMO_MODE=true

# Recipient (also: SMTP_TO, USER_EMAIL)
EMAIL_TO=plant.manager@yourplant.com
EMAIL_FROM=oee-pulse@yourplant.com

# Optional SMTP for real plant brief emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=oee-pulse@yourplant.com
SMTP_TO=plant.manager@yourplant.com
SMTP_USE_TLS=true

# LLM for Insights / Reports Q&A (optional — strong offline fallback always works)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DEFAULT_PROVIDER=gemini

# App
APP_TITLE=OEE Pulse
PLANT_NAME=North Plant
